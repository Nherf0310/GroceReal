{
  "name": "grocereal-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@grocereal/web",
    "dev:api": "npm run start:dev --workspace=@grocereal/api",
    "start": "npm run dev:web",
    "build:shared": "npm run build --workspace=@grocereal/shared",
    "build:api": "npm run prisma:generate && npm run build --workspace=@grocereal/api",
    "build:web": "npm run build --workspace=@grocereal/web",
    "build": "npm run prisma:generate && npm run build:shared && npm run build:api",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:push": "npx prisma db push",
    "prisma:seed": "npx prisma db seed",
    "prisma:studio": "npx prisma studio"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.9",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "pg": "^8.23.1"
  }
}
